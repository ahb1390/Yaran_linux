    "alsa-ucm-conf",
    "dolphin",
    "kate",
    "konsole",
    "gwenview",
    "okular",
    "ark",
    "ffmpegthumbs",
    "unrar",
    "p7zip-full",
    "zip",
    "unzip",
    "kde-spectacle",
    "kcalc",
    "partitionmanager",
    "firefox-esr",
    "plasma-discover",
    "plasma-discover-backend-flatpak",
    "plasma-discover-backend-fwupd",
    "flatpak",
    "ca-certificates",
    "bash-completion",
    "systemd-timesyncd",
    "fonts-vazirmatn",
    "fonts-vazirmatn-variable",
    "fonts-noto-core",
    "fonts-noto-cjk",
    "fonts-noto-mono",
    "fonts-noto-ui-core",
    "fonts-hosny-amiri",
    "fonts-noto-color-emoji",
    "fonts-freefont-ttf",
    "fonts-dejavu-core",
    "hunspell-en-us",
    "hyphen-en-us",
    "libreoffice-writer",
    "libreoffice-calc",
    "libreoffice-impress",
    "libreoffice-draw",
    "libreoffice-base",
    "libreoffice-math",
    "libreoffice-plasma",
    "cabextract",
    "cups",
    "cups-filters",
    "cups-client",
    "system-config-printer",
    "print-manager",
    "fwupd",
    "calamares",
    "pkexec",
    "polkit-kde-agent-1",
    "qml6-module-org-kde-kirigami",
    "qml6-module-qtquick",
    "qml6-module-qtquick-controls",
    "qml6-module-qtquick-layouts",
    "qml6-module-qtquick-window",
    "parted",
    "gdisk",
    "dosfstools",
    "e2fsprogs",
    "btrfs-progs",
    "xfsprogs",
    "ntfs-3g",
    "cryptsetup",
    "os-prober",
    "efibootmgr",
    "apparmor",
    "apparmor-profiles",
    "apparmor-utils",
    "nftables",
    "unattended-upgrades",
    "libpam-systemd",
    "sddm",
    "sddm-theme-breeze",
    "plymouth",
    "plymouth-themes",
    "vlc",
    "curl",
    "wget",
    "git",
    "fastfetch",
    "plasma-systemmonitor",
    "squashfs-tools",
    "rsync",
    "kio-admin",
    "systemsettings",
    "kinfocenter",
    "kscreen",
    "pavucontrol",
    "alsa-utils",
    "alsa-tools-gui",
    "kdeconnect",
    "telegram-desktop",
    "google-chrome-stable",
    "vim",
    "tmux",
    "ranger",
    "timeshift",
    "zram-tools"
  ],
  "exclude_packages": [
    "plasma-welcome",
    "desktop-base",
    "kwallet-pam",
    "kwalletmanager",
    "kde-config-welcome",
    "plasma-browser-integration",
    "nautilus",
    "gnome-terminal",
    "file-roller",
    "evince",
    "eog",
    "totem",
    "rhythmbox",
    "tlp",
    "tlp-rdw",
    "zenity"
  ],
  "pre_chroot_scripts": [
    "hooks/desktop/stage-assets.sh",
    "hooks/desktop/vendor-repos.sh"
  ],
  "post_install_scripts": [
    "hooks/common/update-ca-certificates.sh",
    "hooks/desktop/automatic-updates.sh",
    "hooks/desktop/firewall.sh",
    "hooks/desktop/sysctl.sh",
    "hooks/desktop/plasma-assets.sh",
    "hooks/desktop/theme-command.sh",
    "hooks/desktop/desktop-defaults.sh",
    "hooks/desktop/live-autologin.sh",
    "hooks/desktop/icons-and-launchers.sh",
    "hooks/desktop/flatpak.sh",
    "hooks/common/install-fastfetch.sh",
    "hooks/common/install-ble.sh",
    "hooks/common/bash-experience.sh",
    "hooks/common/install-calamares.sh",
    "hooks/desktop/grub-theme.sh",
    "hooks/desktop/plymouth-theme.sh",
    "hooks/desktop/login-branding.sh",
    "hooks/desktop/install-external-apps.sh",
    "hooks/common/cleanup-assets.sh",
    "hooks/common/verify-image.sh"
  ],
  "boot_append": "quiet splash",
  "squashfs_compression": "xz",
  "os_release": {
    "NAME": "Yaran Linux",
    "PRETTY_NAME": "Yaran Linux 2.0 Minimal (trixie) AMD64",
    "ID": "yaran",
    "ID_LIKE": "debian",
    "VERSION": "2.0",
    "VERSION_ID": "2.0",
    "VARIANT": "Desktop Minimal",
    "VARIANT_ID": "desktop-minimal",
    "LOGO": "yaran",
    "HOME_URL": "https://github.com/ahb1390/Yaran_linux",
    "SUPPORT_URL": "https://github.com/ahb1390/Yaran_linux",
    "BUG_REPORT_URL": "https://github.com/ahb1390/Yaran_linux/issues"
  },
  "install_recommends": false,
  "vendor_repositories": true,
  "services": {
    "enable": [
      "sddm",
      "NetworkManager",
      "systemd-timesyncd",
      "bluetooth",
      "power-profiles-daemon",
      "fstrim.timer",
      "fwupd-refresh.timer",
      "apparmor",
      "nftables",
      "cups",
      "thermald"
    ],
    "disable": [
      "apt-daily.timer",
      "apt-daily-upgrade.timer",
      "unattended-upgrades.service"
    ]
  },
  "grub_menu": {
    "background": "assets/wallpapers/Yaran Emblem/contents/images/1585x992.png"
  },
  "iso_filename": "Yaran-2.0-amd64-minimal.iso",
  "iso_volume_id": "YARAN_AMD64_MINIMAL"
}
