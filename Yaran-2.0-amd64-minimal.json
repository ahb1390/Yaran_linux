    "mesa-vdpau-drivers",
    "libvulkan1",
    "vulkan-tools",
    "va-driver-all",
    "vdpau-driver-all",
    "kde-plasma-desktop",
    "kwin-x11",
    "kwin-wayland",
    "plasma-workspace",
    "xdg-desktop-portal",
    "xdg-desktop-portal-kde",
    "network-manager",
    "wpasupplicant",
    "bluez",
    "udisks2",
    "xdg-user-dirs",
    "kio-extras",
    "breeze",
    "breeze-gtk-theme",
    "breeze-icon-theme",
    "hicolor-icon-theme",
    "plasma-nm",
    "plasma-pa",
    "powerdevil",
    "upower",
    "thermald",
