# Yaran Linux boot splash — Plymouth "script" theme.
#
# Deliberately minimal and robust: one full-screen image scaled to whatever
# resolution the firmware/KMS setup reports. Hardware that cannot initialize a
# graphics renderer falls back to Plymouth's text renderer automatically
# (and the "nomodeset" kernel parameter skips the splash entirely), so no
# device is ever left without a bootable display.

window.SetBackgroundTopColor(0.04, 0.07, 0.06);
window.SetBackgroundBottomColor(0.04, 0.07, 0.06);

sprite = Sprite();

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

image = Image("background.png");
scale_x = screen_width / image.GetWidth();
scale_y = screen_height / image.GetHeight();
scale = Math.Max(Math.Min(scale_x, scale_y), 0.01);

scaled = image.Scale(image.GetWidth() * scale, image.GetHeight() * scale);

sprite.SetImage(scaled);
sprite.SetX((screen_width - scaled.GetWidth()) / 2);
sprite.SetY((screen_height - scaled.GetHeight()) / 2);
sprite.SetZ(100);
